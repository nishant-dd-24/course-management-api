# ──────────────────────────────────────────
# General usage
# ──────────────────────────────────────────
# Copy this file to .env and fill in required values before running Docker Compose or the app locally.
# cp .env.example .env

# ──────────────────────────────────────────
# Database
# ──────────────────────────────────────────
# (Required)
SPRING_DATASOURCE_PASSWORD=your_db_password

# ──────────────────────────────────────────
# JWT
# ──────────────────────────────────────────
# (Required) Must be a Base64-encoded secret of at least 32 raw bytes.
# Generate with: openssl rand -base64 32
JWT_SECRET=

# (Optional) JWT lifetimes
JWT_EXPIRATION_SECONDS=3600
JWT_REFRESH_EXPIRATION_SECONDS=604800

# ──────────────────────────────────────────
# Admin bootstrap
# ──────────────────────────────────────────
# (Optional) Created on first start if the email does not already exist.
# Defaults shown; override for any non-local deployment.
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=changeme
APP_ADMIN_NAME=Admin

# ──────────────────────────────────────────
# Docker image tags (blue-green deployment)
# ──────────────────────────────────────────
# Set to the Git commit SHA of the image to deploy. Defaults to 'latest' if unset.
# scripts/deploy.sh sets these automatically during CI/CD deployment.
IMAGE_TAG_BLUE=latest
IMAGE_TAG_GREEN=latest

# ──────────────────────────────────────────
# Manual local run overrides
# ──────────────────────────────────────────
# Uncomment these only if running locally without Docker Compose (which sets these internally)
# and your local database/redis are not on the default ports/hosts.
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/course_db
# SPRING_DATASOURCE_USERNAME=course_user
# SPRING_DATA_REDIS_HOST=localhost
# SPRING_DATA_REDIS_PORT=6379
